# ─── AI (server-side only) ───────────────────────────────────────────────
# Required for: AI search answers, page summaries, idea expansion,
# auto-categorisation, conversation summaries and "Ask your Second Brain".
# Without it every AI surface shows a "Connect AI" state; everything else works.
ANTHROPIC_API_KEY=
# Optional override (defaults to claude-opus-5-5)
ANTHROPIC_MODEL=

# ─── Supabase (optional) ─────────────────────────────────────────────────
# When both are set, the app requires sign-in (magic link) and stores all
# data in Postgres (see supabase/migrations). When unset, data persists
# locally in the browser so the app works out of the box.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
